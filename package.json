{
	"name": "vim-tools",
	"version": "1.0.0",
	"description": "Neovim-style editing, navigation, and configuration for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"ci": "bun run lint && bun run test && bun run build"
	},
	"keywords": [
		"obsidian",
		"vim",
		"neovim",
		"codemirror"
	],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.36.4",
		"@eslint/js": "^9.39.4",
		"@replit/codemirror-vim": "^6.3.0",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"happy-dom": "^18.0.1",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.4"
	}
}
